# DRAFT, NOT ENABLED. GitHub only runs files ending in .yml or .yaml in this folder, so this one does nothing as it is.
# To turn it on: rename it to release.yml, add the repository secrets listed below, and read docs/releasing.md first.
#
# On a push of a tag like v1.2.3 it does what scripts/release-apk.sh does (build the signed APK, verify it, write a SHA-256
# checksum) and then creates a DRAFT GitHub release with both files attached. A maintainer reviews and publishes the draft.
#
# Runners: this runs on GitHub-hosted runners, which are free for public repositories. If it cannot run, release from a local
# machine with scripts/release-apk.sh instead. Do not move this job to a self-hosted runner unless it is ephemeral and runs
# only for tags pushed by maintainers.
#
# Repository secrets (Settings > Secrets and variables > Actions):
#   BLOEM_ADMIN_KEYSTORE_BASE64     the release keystore file, base64 encoded (base64 -w0 release.jks)
#   BLOEM_ADMIN_KEYSTORE_PASSWORD   keystore password
#   BLOEM_ADMIN_KEY_ALIAS           key alias
#   BLOEM_ADMIN_KEY_PASSWORD        key password
#   BLOEM_ADMIN_GOOGLE_SERVICES_JSON  (optional) the Firebase config for push. Without it the APK has push turned off.
name: Release

on:
  push:
    tags:
      - "v[0-9]+.[0-9]+.[0-9]+"

permissions:
  contents: read

concurrency:
  group: release-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    # Create an environment named `release` (Settings > Environments) with required reviewers and a deployment rule limited to
    # tags, and put the five secrets listed above in it instead of in repository secrets. Then no push can reach them unreviewed.
    environment: release
    permissions:
      contents: write # only to create the draft release
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0 # the version comes from `git describe`, which needs the tags
          persist-credentials: false # later steps run project code; the draft release step passes its own token

      - name: Require the tagged commit to be on main
        run: |
          # Anyone with write access can push a tag on any branch. Only commits that went through main get a signed build.
          git merge-base --is-ancestor "$GITHUB_SHA" origin/main || { echo "::error::$GITHUB_REF_NAME is not on main"; exit 1; }

      - name: Set up JDK 17
        uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          java-version: "17"
          distribution: "temurin"

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@748248ddd2a24f49513d8f472f81c3a07d4d50e1 # v4.4.4
        with:
          cache-disabled: true # a signed build does not restore caches

      - name: Unit tests
        run: ./gradlew testDebugUnitTest

      - name: Write the signing key and Firebase config to temporary files
        env:
          KEYSTORE_BASE64: ${{ secrets.BLOEM_ADMIN_KEYSTORE_BASE64 }}
          GOOGLE_SERVICES_JSON: ${{ secrets.BLOEM_ADMIN_GOOGLE_SERVICES_JSON }}
        run: |
          set -euo pipefail
          [ -n "$KEYSTORE_BASE64" ] || { echo "BLOEM_ADMIN_KEYSTORE_BASE64 is not set"; exit 1; }
          umask 077
          printf '%s' "$KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/release.jks"
          echo "BLOEM_ADMIN_KEYSTORE=$RUNNER_TEMP/release.jks" >> "$GITHUB_ENV"
          if [ -n "$GOOGLE_SERVICES_JSON" ]; then
            printf '%s' "$GOOGLE_SERVICES_JSON" > "$RUNNER_TEMP/google-services.json"
            echo "BLOEM_ADMIN_GOOGLE_SERVICES_JSON=$RUNNER_TEMP/google-services.json" >> "$GITHUB_ENV"
          fi

      - name: Build, sign, verify and checksum the APK
        env:
          BLOEM_ADMIN_KEYSTORE_PASSWORD: ${{ secrets.BLOEM_ADMIN_KEYSTORE_PASSWORD }}
          BLOEM_ADMIN_KEY_ALIAS: ${{ secrets.BLOEM_ADMIN_KEY_ALIAS }}
          BLOEM_ADMIN_KEY_PASSWORD: ${{ secrets.BLOEM_ADMIN_KEY_PASSWORD }}
          TAG: ${{ github.ref_name }}
        run: |
          # The checkout is detached at the tag's commit; the script needs the tag to exist, which it does after a tag push.
          scripts/release-apk.sh "$TAG"

      - name: Create the draft release
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ github.ref_name }}
        run: |
          set -euo pipefail
          VERSION="${TAG#v}"
          gh release create "$TAG" \
            --repo "$GITHUB_REPOSITORY" \
            --draft --verify-tag \
            --title "Bloem Admin $VERSION" \
            --generate-notes \
            "dist/bloem-admin-$VERSION.apk" \
            "dist/bloem-admin-$VERSION.apk.sha256"

      - name: Remove the signing key
        if: always()
        run: rm -f "$RUNNER_TEMP/release.jks" "$RUNNER_TEMP/google-services.json"
