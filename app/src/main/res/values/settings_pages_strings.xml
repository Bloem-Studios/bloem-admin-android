    <string name="sp_downloads_title">Downloads</string>
    <string name="sp_downloads_desc">Offline downloads, per-user and server-wide limits, and prepared copies</string>
    <string name="sp_downloads_group0">Downloads</string>
    <string name="sp_download_enabled_label">Allow downloads</string>
    <string name="sp_download_enabled_help">The switch for the whole server. On, access groups and accounts decide who may download. Off, nobody can.</string>
    <string name="sp_download_transcode_enabled_label">Prepare device-friendly copies</string>
    <string name="sp_download_transcode_enabled_help">Converts video the device can\'t play and offers lower qualities. Off, every download keeps the original video, even where the device can\'t play it.</string>
    <string name="sp_download_max_concurrent_prepares_label">Files prepared at once</string>
    <string name="sp_download_max_concurrent_prepares_help">0 uses the built-in default of 2</string>
    <string name="sp_download_artifact_disk_ceiling_percent_label">Disk ceiling</string>
    <string name="sp_download_artifact_disk_ceiling_percent_help">Above this disk fill, cached files at that location are deleted early, whatever the budget. 50 to 95; nodes stop taking playback at 95% when downloads share their transcode disk.</string>
    <string name="sp_download_server_bandwidth_mbps_label">Server bandwidth</string>
    <string name="sp_download_server_bandwidth_mbps_help">All downloads on this server combined. 0 is unlimited.</string>
    <string name="sp_downloads_group1">Per user</string>
    <string name="sp_download_user_bandwidth_mbps_label">Per-user bandwidth</string>
    <string name="sp_download_user_bandwidth_mbps_help">0 is unlimited</string>
    <string name="sp_download_max_concurrent_per_user_label">Downloads at once per user</string>
    <string name="sp_download_max_concurrent_per_user_help">Counted per user, alongside the per-user bandwidth cap. 0 is unlimited.</string>
    <string name="sp_download_max_per_period_label">Downloads per period</string>
    <string name="sp_download_max_per_period_help">How many each user may start in the period below. 0 is unlimited.</string>
    <string name="sp_download_period_duration_label">Period length</string>
    <string name="sp_download_period_duration_help">Rolling window each user\'s count is measured over, for example 24h or 168h</string>
    <string name="sp_downloads_group2">Whole server</string>
    <string name="sp_download_local_transcode_fallback_label">Prepare locally when workers are unavailable</string>
    <string name="sp_download_local_transcode_fallback_help">This is separate from live playback routing</string>
    <string name="sp_download_artifact_cache_hours_label">Keep cached files for</string>
    <string name="sp_download_artifact_cache_hours_help">Hours a prepared file nothing is waiting on stays after its last use, so another download or a re-download can reuse it. 0 to 720; 0 deletes it once nothing needs it and it has gone unused for ten minutes.</string>
