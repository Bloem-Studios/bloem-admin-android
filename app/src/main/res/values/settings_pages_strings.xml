    <string name="sp_notifications_fanout_max_series_burst_help">Anything past this is skipped for that batch</string>
    <string name="sp_notifications_fanout_max_event_age_hours_label">Max content age</string>
    <string name="sp_notifications_fanout_max_event_age_hours_help">Older items are dropped instead of arriving as stale news</string>
