<!-- Named settings pages. Names, labels, units and help text follow the web admin (web/src/pages/admin-settings). Generated once from the catalogue; edit by hand from here. -->
<resources>
    <string name="sp_general_title">General</string>
    <string name="sp_general_desc">The server\'s name and public address, the proxies in front of it, and the database</string>
    <string name="sp_general_group0">Identity</string>
    <string name="sp_branding_server_name_label">Server name</string>
    <string name="sp_branding_server_name_help">Shown on the sign-in page and in apps</string>
    <string name="sp_branding_login_subtitle_label">Login subtitle</string>
    <string name="sp_branding_login_subtitle_help">Shown under the server name on the sign-in page</string>
    <string name="sp_general_group1">Network</string>
    <string name="sp_server_public_url_label">Public URL</string>
    <string name="sp_server_public_url_help">The HTTPS address users open. Used for websocket origins and links in email notifications.</string>
    <string name="sp_server_lan_discovery_label">Show on the local network</string>
    <string name="sp_server_lan_discovery_help">Silo apps on the same network list this server when adding one, so nobody has to type its address. Needs a network that passes multicast (Docker host networking, not the default bridge).</string>
    <string name="sp_server_local_url_label">Local network address</string>
    <string name="sp_server_local_url_help">Where devices on your home network reach the server directly: the host\'s IP and the port it listens on, or the published port under Docker. Signed-in apps switch to it on their own while they can reach it, over an encrypted connection. Leave empty when apps already reach the server directly.</string>
    <string name="sp_clientip_trusted_proxies_label">Trusted proxies</string>
    <string name="sp_clientip_trusted_proxies_help">Comma-separated proxy ranges; empty keeps the private defaults</string>
    <string name="sp_general_group2">Database</string>
    <string name="sp_database_max_connections_label">Maximum Postgres connections</string>
    <string name="sp_database_max_connections_help">Raise only if the logs show connection-pool waits</string>
    <string name="sp_sign_in_title">Sign-in</string>
    <string name="sp_sign_in_desc">Silo passwords and signups, single sign-on, and network sign-in</string>
    <string name="sp_sign_in_group0">Passwords</string>
    <string name="sp_auth_local_password_login_label">Allow password sign-in</string>
    <string name="sp_auth_local_password_login_help">Off: everyone signs in with the provider, except break-glass admins. Needs at least one break-glass admin; the server owner is one by default.</string>
    <string name="sp_signup_enabled_label">Public signups</string>
    <string name="sp_signup_enabled_help">Anyone with a valid invite code can create an account</string>
    <string name="sp_password_reset_self_service_enabled_label">Self-service password reset</string>
    <string name="sp_password_reset_self_service_enabled_help">Adds “Forgot password?” to the sign-in page, so people can get a reset link by email. Needs email and the public URL.</string>
    <string name="sp_sign_in_group1">Single sign-on</string>
    <string name="sp_sign_in_group1_note">Let people sign in with your identity provider. A server uses one provider at a time. Setting up a provider is done in the web admin.</string>
    <string name="sp_auth_email_auto_match_label">Match existing accounts by email</string>
    <string name="sp_auth_email_auto_match_help">A first sign-in connects to the regular account with the same email, when the provider says the email is verified. Admin, owner and break-glass accounts are never matched. Whoever controls that email at the provider takes over the account, so turn this on only if the provider verifies every email.</string>
    <string name="sp_playback_title">Playback</string>
    <string name="sp_playback_desc">Watch thresholds, transcoding, connection speed tests, and skip markers</string>
    <string name="sp_playback_group0">Watch behavior</string>
    <string name="sp_playback_watched_threshold_label">Mark watched at</string>
    <string name="sp_playback_min_resume_threshold_label">Show in Continue Watching after</string>
    <string name="sp_playback_min_resume_threshold_help">Progress below this is ignored</string>
    <string name="sp_playback_group1">Transcoding</string>
    <string name="sp_playback_transcode_enabled_label">Video transcoding</string>
    <string name="sp_playback_transcode_enabled_help">Off never re-encodes video. The server still repackages files and converts audio for devices that need it.</string>
    <string name="sp_playback_hw_accel_label">Hardware acceleration</string>
    <string name="sp_playback_hw_accel_help">Auto picks the best device. If startup fails, it keeps GPU encoding with CPU decoding before falling back to software.</string>
    <string name="sp_opt_playback_hw_accel_auto">Auto</string>
    <string name="sp_opt_playback_hw_accel_qsv">Intel Quick Sync (QSV)</string>
    <string name="sp_opt_playback_hw_accel_vaapi">VA-API</string>
    <string name="sp_opt_playback_hw_accel_nvenc">NVIDIA NVENC</string>
    <string name="sp_opt_playback_hw_accel_videotoolbox">VideoToolbox (macOS)</string>
    <string name="sp_opt_playback_hw_accel_none">Software</string>
    <string name="sp_allow_4k_transcode_label">Allow 4K transcoding</string>
    <string name="sp_allow_4k_transcode_help">Heavy load on most hardware</string>
    <string name="sp_playback_prefer_lower_version_transcode_label">Prefer 1080p versions</string>
    <string name="sp_playback_prefer_lower_version_transcode_help">Transcode from the 1080p version instead of the 4K file when both exist</string>
    <string name="sp_playback_allow_hevc_encoding_label">Allow HEVC encoding</string>
    <string name="sp_playback_allow_hevc_encoding_help">Use HEVC for clients that support HEVC over HLS. Other clients keep H.264.</string>
    <string name="sp_playback_transcode_hardware_tone_map_enabled_label">Hardware HDR tone mapping</string>
    <string name="sp_playback_transcode_hardware_tone_map_enabled_help">Allows validated local or remote GPU executors to convert HDR video to SDR when transcoding</string>
    <string name="sp_playback_transcode_software_tone_map_enabled_label">Software HDR tone mapping</string>
    <string name="sp_playback_transcode_software_tone_map_enabled_help">Allows the CPU to convert HDR video to SDR when transcoding. This can be very CPU-intensive.</string>
    <string name="sp_enable_transcode_throttle_label">Throttle transcoding</string>
    <string name="sp_enable_transcode_throttle_help">Pause encoding once the client is far enough ahead</string>
    <string name="sp_transcode_throttle_seconds_label">Buffer ahead</string>
    <string name="sp_playback_group2">Connection speed tests</string>
    <string name="sp_playback_bandwidth_probe_automatic_label">Automatic speed tests</string>
    <string name="sp_playback_bandwidth_probe_automatic_help">Apps test a device\'s connection only when the server has no current reading for it. Off, viewers can still run Test speed in Settings.</string>
    <string name="sp_playback_bandwidth_probe_max_age_days_label">Keep a reading for</string>
    <string name="sp_playback_bandwidth_probe_max_age_days_help">1 to 30. An app tests again once its reading is older.</string>
    <string name="sp_playback_group3">Skip markers</string>
    <string name="sp_playback_group3_note">Markers identify intros, credits, recaps, and previews so players can offer skip controls</string>
    <string name="sp_markers_mode_label">Marker source</string>
    <string name="sp_markers_mode_help">Online markers take priority. The server skips local detection of an intro or credits when an online one is saved in your library. Local detection uses CPU.</string>
    <string name="sp_opt_markers_mode_off">Off</string>
    <string name="sp_opt_markers_mode_local">Detect on this server</string>
    <string name="sp_opt_markers_mode_both">Online preferred + server detection</string>
    <string name="sp_opt_markers_mode_online">Online providers only</string>
    <string name="sp_logging_title">Logging</string>
    <string name="sp_logging_desc">What the server logs, and how much log history the database keeps</string>
    <string name="sp_logging_group0">Server log</string>
    <string name="sp_server_log_level_label">Log level</string>
    <string name="sp_server_log_level_help">Sets the container log\'s level; Debug is loud, so keep it for chasing a problem. The Logs page records Info and above either way. Takes effect without a restart.</string>
